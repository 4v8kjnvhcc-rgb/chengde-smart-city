# 本机开发环境变量示例（复制为 local.env 后按需修改，勿提交 Git）
# PowerShell 加载示例：Get-Content local.env | ForEach-Object { if ($_ -match '^(.*)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process') } }

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=smart_city
MYSQL_USER=root
MYSQL_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379

# 开源组件联调（compose/oss-stack.yml）
INTEGRATION_ENABLED=true
INTEGRATION_DEMO_FALLBACK=false

OM_URL=http://localhost:8585/api/v1
OM_USER=admin@open-metadata.org
OM_PASSWORD=admin

DE_URL=http://localhost:8100
DE_EMBED_BASE=http://localhost:8100

DS_URL=http://localhost:12345/dolphinscheduler
DS_USER=admin
DS_PASSWORD=dolphinscheduler123

KETTLE_URL=http://localhost:18081
KETTLE_USER=cluster
KETTLE_PASSWORD=cluster

ES_URL=http://localhost:9200
SEAWEED_S3_ENDPOINT=http://localhost:8333
SEAWEED_S3_BUCKET=smartcity-docs
MONGO_URL=mongodb://localhost:27017
CANAL_URL=http://localhost:19090
