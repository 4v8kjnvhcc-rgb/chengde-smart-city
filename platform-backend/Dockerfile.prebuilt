# 只打包本机已构建好的 jar（构建过程见 scripts/build_prod_images.ps1）
# 用途：本机 Docker 容器内 DNS 常不可用，故在宿主机跑 mvn，再把产物打进镜像
FROM eclipse-temurin:17-jre
WORKDIR /app
RUN useradd -r -u 10001 appuser \
  && apt-get update && apt-get install -y --no-install-recommends curl tzdata \
  && rm -rf /var/lib/apt/lists/*
COPY target/platform-backend-*.jar /app/app.jar
USER appuser
EXPOSE 8080
# 生产按北京时间落库/展示；JAVA_TOOL_OPTIONS 即使 compose 覆盖 JAVA_OPTS 也会生效
ENV TZ=Asia/Shanghai
ENV JAVA_TOOL_OPTIONS="-Duser.timezone=Asia/Shanghai"
ENV JAVA_OPTS="-Duser.timezone=Asia/Shanghai -Xms512m -Xmx1536m"
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
